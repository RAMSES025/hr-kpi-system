# Виртуальное окружение
venv/
env/

# Кэш Python
__pycache__/
*.pyc

# База данных (чтобы не слить в сеть реальные данные сотрудников)
*.db
*.sqlite3

# Секретный ключ, которым подписываются cookie входа — свой у каждой
# установки приложения, никогда не должен попадать в git
session_secret.key

# Системные файлы macOS
.DS_Store
